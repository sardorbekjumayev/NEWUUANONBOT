# University Anonymous Community Platform Environment Config

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_SECRET=change-this-to-a-secure-random-32-byte-key

# Database Connection (sqlite, pgsql, or mysql)
DB_DRIVER=sqlite
DB_PATH=database/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uac_db
DB_USERNAME=uac_user
DB_PASSWORD=secret

# Telegram Settings
TELEGRAM_BOT_TOKEN=7793113949:AAE1qD5OxEtYSsAxB00McQzO5N2RsgfaX5U
TELEGRAM_BOT_USERNAME=UUAnonBot
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_MODERATION_GROUP_ID=-1009876543210
TELEGRAM_WEBHOOK_SECRET=super-secret-webhook-hash

# AI Moderation Engine
AI_MODERATION_ENABLED=true
AI_PROVIDER=mock # mock, openai, or gemini
AI_API_KEY=your-ai-api-key

# Admin Credentials
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123456

# Rate Limits (Submissions per 10m, Comments per 30m)
RATE_LIMIT_SUBMISSIONS=5
RATE_LIMIT_COMMENTS=10
